{
  "name": "git-task-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "GitTask - GitHub TODO/FIXME tracker",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:client\"",
    "dev:api": "cd api && npm run start:dev",
    "dev:client": "cd client && npm run dev",
    "install:all": "npm run install:api && npm run install:client",
    "install:api": "cd api && npm install",
    "install:client": "cd client && npm install",
    "build": "npm run build:api && npm run build:client",
    "build:api": "cd api && npm run build",
    "build:client": "cd client && npm run build",
    "heroku-postbuild": "cd api && npm install && npm run build",
    "start": "cd api && npm run start:prod"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
